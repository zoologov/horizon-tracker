{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/beadloom-guard.py",
        "matcher": "Write|StrReplace|Edit|NotebookEdit|Shell",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/beadloom-guard.py",
        "failClosed": true
      }
    ]
  }
}
