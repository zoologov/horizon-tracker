[Unit]
Description=Start the Horizon evening check-out daily at 16:30 Europe/Moscow, its range start

[Timer]
# Every day, not Mon-Fri: the working-day verdict (isdayoff.ru, falling back to
# Mon-Fri) belongs to the service, which reports a non-working day as a skip.
# At the start of the range the day's moment is drawn from (16:30-17:10), never
# later: the service draws today's moment and waits for it in its own process,
# and a run started after the moment's 5-minute window only reports it missed.
# The zone is this repository's configured HT_TIMEZONE: a host in another zone
# changes it here and in the GitHub variable together, and the deploy refuses a
# run whose HT_TIMEZONE differs (docs/guides/deployment.md).
OnCalendar=*-*-* 16:30:00 Europe/Moscow
Unit=horizon-checkout.service

# Never catch up a run missed while the host was down: a late run is worse than
# none, and a catch-up at boot would land after the range start anyway, where the
# service only waits for a moment it may already have missed.
Persistent=no

# The drawn moment can be the range start itself, and its window is five minutes;
# systemd's default 1-minute accuracy would let the timer fire up to a minute late,
# so ask for the second it was scheduled. No RandomizedDelaySec: the randomness is
# the service's draw, which ties the evening to the morning (RFC HT-003).
AccuracySec=1s

[Install]
WantedBy=timers.target
